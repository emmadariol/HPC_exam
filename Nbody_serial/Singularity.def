Bootstrap: docker
From: ubuntu:24.04

%files
    . /opt/nbody

%post
    OSU_VERSION="${OSU_VERSION:-7.5.2}"
    OSU_URL="${OSU_URL:-https://mvapich.cse.ohio-state.edu/download/mvapich/osu-micro-benchmarks-${OSU_VERSION}.tar.gz}"

    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential openmpi-bin libopenmpi-dev ca-certificates wget
    rm -rf /var/lib/apt/lists/*

    wget -O /tmp/osu.tar.gz "$OSU_URL"
    mkdir -p /tmp/osu
    tar -xzf /tmp/osu.tar.gz -C /tmp/osu --strip-components=1
    cd /tmp/osu
    ./configure CC=mpicc --prefix=/opt/osu
    make -j"$(nproc)"
    make install
    ln -sf /opt/osu/libexec/osu-micro-benchmarks/mpi/pt2pt/osu_latency /usr/local/bin/osu_latency
    ln -sf /opt/osu/libexec/osu-micro-benchmarks/mpi/pt2pt/osu_bw /usr/local/bin/osu_bw
    rm -rf /tmp/osu /tmp/osu.tar.gz

    cd /opt/nbody
    export CFLAGS="-O3 -march=x86-64-v3 -Wall -Wextra -Wpedantic"
    make clean
    make

%environment
    export OMP_NUM_THREADS=${OMP_NUM_THREADS:-1}

%runscript
    exec /opt/nbody/nbody_direct_hybrid "$@"

%test
    # Esegue un test rapido per confermare che la build ha prodotto un eseguibile funzionante.
    cd /opt/nbody
    ./generate_ic --model 0 --n 64 --seed 1 --output test.bin
    ./nbody_direct_hybrid --input test.bin --nsteps 2 --dt 1e-4 --eps 0.05 --quiet
