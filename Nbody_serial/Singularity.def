Bootstrap: docker
From: ubuntu:22.04

%files
    # Copy the repository into the container at build time.
    . /opt/nbody

%post
    # Build-time defaults for the OSU Micro-Benchmarks suite.
    OSU_VERSION="${OSU_VERSION:-7.5.2}"
    OSU_URL="${OSU_URL:-https://mvapich.cse.ohio-state.edu/download/mvapich/osu-micro-benchmarks-${OSU_VERSION}.tar.gz}"

    # Install the C toolchain, OpenMPI, and download helpers required to compile
    # both the N-body executables and the OSU benchmark binaries.
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential openmpi-bin libopenmpi-dev ca-certificates wget
    rm -rf /var/lib/apt/lists/*

    # Install OSU point-to-point tests and expose short paths used by
    # run_benchmarks.sh (`osu_latency` and `osu_bw`).
    wget -O /tmp/osu.tar.gz "$OSU_URL"
    mkdir -p /tmp/osu
    tar -xzf /tmp/osu.tar.gz -C /tmp/osu --strip-components=1
    cd /tmp/osu
    ./configure CC=mpicc --prefix=/opt/osu
    make -j"$(nproc)"
    make install
    ln -sf /opt/osu/libexec/osu-micro-benchmarks/mpi/pt2pt/osu_latency /usr/local/bin/osu_latency
    ln -sf /opt/osu/libexec/osu-micro-benchmarks/mpi/pt2pt/osu_bw /usr/local/bin/osu_bw
    rm -rf /tmp/osu /tmp/osu.tar.gz

    # Compile the project with a portable CPU target; cluster-native builds
    # outside the container still use -march=native through the Makefile default.
    cd /opt/nbody
    export CFLAGS="-O3 -march=x86-64-v3 -Wall -Wextra -Wpedantic"
    make clean
    make

%environment
    # Keep the container conservative by default; Slurm jobs override this when
    # running MPI+OpenMP configurations.
    export OMP_NUM_THREADS=${OMP_NUM_THREADS:-1}

%runscript
    # `singularity run nbody.sif ...` behaves like launching the hybrid solver.
    exec /opt/nbody/nbody_direct_hybrid "$@"

%test
    # Fast build-time smoke test: generate a tiny input and run two solver steps.
    cd /opt/nbody
    ./generate_ic --model 0 --n 64 --seed 1 --output test.bin
    ./nbody_direct_hybrid --input test.bin --nsteps 2 --dt 1e-4 --eps 0.05 --quiet
